{
  "name": "custom_waka_readme",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.24.0",
  "description": "GitHub Action: render your custom wakatime-powered README",
  "author": "Twisuki",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "fix": "eslint . --fix",
    "check": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --alias:@=./src --outfile=dist/index.cjs",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "isolated-vm": "^7.0.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "esbuild": "^0.24.0",
    "eslint": "^10.8.0",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
